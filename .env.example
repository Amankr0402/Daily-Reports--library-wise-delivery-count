# ============================================================
#  Environment Variables — Daily Subscriber Report
#  Copy this file to .env and fill in your SMTP credentials.
#  NEVER commit the .env file to version control.
# ============================================================

# SMTP Configuration (Outlook / Office 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-outlook-password
SMTP_FROM=your-email@yourcompany.com

# Server
PORT=3000

# Cron schedule (default: every day at 09:00)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 10 * * *
