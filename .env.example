# ============================================================
#  Environment Variables — Daily Sales & Revenue Report
#  Copy this file to .env and fill in your SMTP credentials.
#  NEVER commit the .env file to version control.
# ============================================================

# SMTP Configuration (Google Workspace / Gmail / Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourcompany.com

# Server
PORT=3000

# Cron schedule (4:30 PM IST daily)
CRON_SCHEDULE=30 16 * * *
